# Copy to .env.local for local work. Add the same keys in Vercel, Project Settings, Environment Variables.

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CAREERS_EMAIL=

# Firebase web app (Firebase console, Project settings, Your apps). Safe to expose.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase service account (Project settings, Service accounts, Generate new private key). Secret.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the key in quotes on one line with \n for line breaks.
FIREBASE_PRIVATE_KEY=

# Optional. New leads and bookings are posted here as JSON (Make.com or n8n webhook).
MAKE_WEBHOOK_URL=

# Optional. Cloudflare Turnstile spam check. Leave both empty to skip it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Outbound email through Resend (team notifications, visitor confirmations, admin compose).
# Without RESEND_API_KEY nothing is sent: automatic emails are logged as "skipped" and admin compose answers 503.
RESEND_API_KEY=
# Sender. The domain must be verified in Resend. Default: Imperium Solutions <tom@imperiumsolutionshq.com>
EMAIL_FROM=
# Who receives the team notifications. Comma separated for several. Default: tom@imperiumsolutionshq.com
EMAIL_TEAM_TO=
